# ==============================================================================
# GEMA Restaurant & Sociëteit — Production Environment Template
# ==============================================================================
# Copy this template to .env in your deployment location (/opt/gema/.env)
# Provide strong, randomly generated secrets for all fields.
# NEVER commit the active production .env file to Git.
# ==============================================================================

# PostgreSQL Credentials (used by both postgres service and web container)
POSTGRES_USER=gema_user
POSTGRES_PASSWORD=replace-with-strong-db-password-at-least-24-chars
POSTGRES_DB=gema_production

# Payload CMS Secret (Min 32 random characters for JWT session encryption)
PAYLOAD_SECRET=replace-with-strong-payload-secret-at-least-32-chars

# Next.js Draft Mode Preview Secret (Server-only, min 32 characters)
PREVIEW_SECRET=replace-with-strong-preview-secret-at-least-32-chars

# Public URL of the production website (e.g. https://gemagroup.id)
NEXT_PUBLIC_SERVER_URL=https://gemagroup.id

# Host Persistent Media Directory (defaults to /opt/gema/data/media)
MEDIA_DIR=/opt/gema/data/media
