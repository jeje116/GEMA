# Database connection string (PostgreSQL)
DATABASE_URI=postgresql://user:password@127.0.0.1:5432/dbname

# Secret key used to encrypt session tokens in Payload (min 32 characters)
PAYLOAD_SECRET=your-payload-secret-at-least-32-characters

# Public base URL of the Next.js server
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Secret for securing Next.js Draft Mode Preview (server-only)
PREVIEW_SECRET=your-preview-secret-at-least-32-characters

# Cloudflare R2 Object Storage (S3 API - Production)
# Required in production. If any R2 variable is set, ALL must be set (atomic configuration).
# When enabled, uploads are sent directly to R2 and local filesystem storage is disabled.
# When omitted, Payload falls back to local filesystem storage (apps/web/public/media/cms/) for local development.
# R2_BUCKET=gema-media-prod
# R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://media.gemagroup.id
